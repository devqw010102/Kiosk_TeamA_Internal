<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
	   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	   xsi:schemaLocation="http://www.springframework.org/schema/beans
	   http://www.springframework.org/schema/beans/spring-beans-4.0.xsd">

	<!-- EDU_INFO -->
	<bean name = "eduInfoIdGnrStrategy"
		  class = "egovframework.rte.fdl.idgnr.impl.strategy.EgovIdGnrStrategyImpl">
		<property name = "fillChar" value = "0" />
		<property name = "cipers" value = "3" />
		<property name = "prefix" value = "EDU_" />	  
	</bean>

	<bean name="eduInfoIdGnService"
		  class="egovframework.rte.fdl.idgnr.impl.EgovTableIdGnrServiceImpl"
		  destroy-method="destroy">
		<property name = "dataSource" ref = "dataSource" />
		<property name = "blockSize" value = "1" />
		<property name = "table" value = "COMTECOPSEQ" />
		<property name = "tableName" value = "EDU_INFO" />
		<property name = "strategy" ref = "eduInfoIdGnrStrategy" />
  	</bean>	   
  	
