<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="kr.hcnc.mapper.TransportMapper">

	<!-- 교통 정보 목록 조회 -->
	<select id="selectTransportList" resultType="kr.hcnc.vo.TransportVO">
		SELECT TRANSPORT_ID,
               TYPE,
               CONTENT,
               CREATED_AT,
               UPDATED_AT,
               DEL_YN
          FROM TRANSPORT
         WHERE DEL_YN = 'N'
         ORDER BY TYPE, TRANSPORT_ID
	</select>
</mapper>
